# ---- Python / backend ----
backend/.venv/
**/__pycache__/
*.pyc

# ---- Database ----
# The SQLite DB IS tracked on purpose: it holds the user's personal coaching
# data, which should be versioned alongside the app. Only transient SQLite
# side files (WAL / shared-memory) are ignored.
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# ---- Uploaded videos (Video Analysis tab) ----
# Clips can be large; keep them out of the repo. The DB still tracks their
# metadata + AI analysis, so only the raw media files are ignored.
backend/data/videos/
backend/data/profile_refs/

# ---- ML models (Phase 4) ----
# Track the small table-ROI seg model (needed for table detection); ignore other
# (large / user-supplied) models like an optional TrackNet ONNX ball detector.
backend/data/models/*
!backend/data/models/roi_seg.pt

# ---- Player identity (ArcFace enrollment) ----
# Raw portrait photos + the cached embeddings are personal/regenerable; keep the
# folder (via README) but not its contents. Re-enroll to rebuild identity.npz.
backend/data/identity/me/*
!backend/data/identity/me/README.txt
backend/data/identity/identity.npz
backend/data/identity/enroll_meta.json

# ---- Node / frontend ----
frontend/node_modules/
frontend/dist/

# TypeScript build artifacts (generated by `tsc -b`)
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
