# ---- Python / backend ----
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/

# ---- Database ----
# The SQLite DB IS tracked on purpose: it holds the user's personal coaching
# data, which should be versioned alongside the app. Only transient SQLite
# side files (WAL / shared-memory) are ignored.
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
# Daily on-startup snapshots (app/core/backup.py) — local safety net only.
backend/data/backups/

# ---- Retired video-analysis pipeline data (feature deleted 2026-07-29) ----
# Local artefacts of the removed CV stack are kept on disk as user data but
# never tracked: ML models, portrait photos, cached face embeddings.
backend/data/models/
backend/data/videos/
backend/data/profile_refs/
backend/data/identity/me/*
!backend/data/identity/me/README.txt
backend/data/identity/identity.npz
backend/data/identity/enroll_meta.json

# ---- Node / frontend ----
frontend/node_modules/
frontend/dist/

# TypeScript build artifacts (generated by `tsc -b`)
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# OpenAPI dump (intermediate of `npm run gen:api`; schema.d.ts IS tracked)
frontend/openapi.json

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
